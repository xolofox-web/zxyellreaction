{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/login", "destination": "/admin.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/analytics", "destination": "/index.html" },
    { "source": "/((?!api/|css/|js/|assets/|favicon.ico).*)", "destination": "/index.html" }
  ]
}
